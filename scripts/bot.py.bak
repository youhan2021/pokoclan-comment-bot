                ("可能吧，我也觉得", 7),
            ],
            "neutral": [
                ("有点这种感觉", 6),
                ("可能吧", 4),
                ("好像确实是…", 6),
            ],
        },
    },
    "cn_liberal_girl": {
        "zh": {
            "pos": [
                ("我有点喜欢{subject}…的感觉", 12),
                ("{subject}感觉还挺微妙的", 10),
                ("有点想说{subject}但又说不清", 12),
                ("感觉挺真实的…", 7),
                ("其实我也有点这种感觉", 10),
            ],
            "neg": [
                ("有点说不清的感觉…", 8),
                ("{subject}感觉有点微妙", 9),
                ("说实话对{subject}有点无语", 11),
            ],
            "neutral": [
                ("我有点…的感觉", 7),
                ("感觉这种东西还挺微妙的", 11),
                ("感觉挺真实的…", 7),
                ("有点想说点什么但是又说不清", 14),
                ("我有点…的感觉吧", 8),
            ],
        },
        "en": {
            "pos": [
                ("I kinda feel the same way", 24),
                ("That hits different honestly", 26),
            ],
            "neg": [
                ("kinda off tbh", 12),
                ("not really feeling it", 19),
            ],
            "neutral": [
                ("I kinda feel that", 17),
                ("that makes sense i guess", 22),
            ],
        },
    },
}


def _generate_reply_template_fallback(source_content: str, personality: str, language: str, max_len: int) -> str:
    """Fallback: content-aware template-based reply using extracted keywords + sentiment."""
    pool = _CTEMPLATE_POOLS.get(personality, _CTEMPLATE_POOLS["jp_girl"])
    lang_pool = pool.get(language, pool.get("zh", pool.get("ja", {})))

    subject, sentiment = _extract_keywords(source_content)

    # Try sentiment-keyed templates first
    candidates = []
    if sentiment in lang_pool:
        candidates = lang_pool[sentiment]

    # Fallback to neutral if nothing found
    if not candidates and "neutral" in lang_pool:
        candidates = lang_pool["neutral"]

    if not candidates:
        return ""

    # Pick random template (weighted by priority)
    weighted = [(t, w) for t, w in candidates]
    templates, weights = zip(*weighted)
    template = random.choices(templates, weights=weights, k=1)[0]

    # Fill slot
    if "{subject}" in template:
        reply = template.replace("{subject}", subject) if subject else template.replace("{subject}", "")
    else:
        reply = template

    reply = re.sub(r"\s+", " ", reply).strip()
    return reply[:max_len]


def generate_reply(ctx: ReplyContext, max_len: int = 1024) -> str:
    """Generate a contextual reply using MiniMax LLM only (no template fallback)."""
    system_prompt = _build_llm_system_prompt(ctx.personality, ctx.system_prompt, ctx.language)
    user_prompt = _build_llm_user_prompt(ctx)

    llm_reply = _minimax_chat(
        system_prompt=system_prompt,
        user_prompt=user_prompt,
        max_tokens=min(max_len, 1024),
        temperature=0.7,
    )

    if llm_reply and llm_reply.strip():
        return llm_reply.strip()[:max_len]

    return ""


# ── Heuristics ───────────────────────────────────────────────────────────────

def should_reply_content(content: str) -> bool:
    if not content or len(content.strip()) < 5:
        return False
    spam = ["click here", "buy now", "free money", "earn $", "DM me", "discord.gg"]
    if any(w in content.lower() for w in spam):
        return False
    return True


def should_like_post(content: str, system_prompt: str, language: str) -> bool:
    if not content or len(content.strip()) < 10:
        return False
    spam = ["click here", "buy now", "free money", "earn $", "DM me", "discord.gg"]
    if any(w in content.lower() for w in spam):
        return False
    positive = ["我", "我觉得", "?", "actually", "really", "很有意思", "推荐", "吐槽",
                "game", "ゲーム", "游戏", "lol", "nice", "确实", "interesting", "amazing"]
    score = sum(1 for s in positive if s.lower() in content.lower())
    return score >= 1


def should_like_comment(content: str, system_prompt: str, language: str) -> bool:
    if not content or len(content.strip()) < 8:
        return False
    spam = ["click here", "buy now", "free money", "discord.gg"]
    if any(w in content.lower() for w in spam):
        return False
    positive = ["同意", "哈哈", "确实", "有意思", "?", "lol", "nice", "真的", "其实",
                "我", "game", "ゲーム", "游戏", "赞", "interesting"]
    score = sum(1 for s in positive if s.lower() in content.lower())
    return score >= 1


# ── Step 1: Chat replies ──────────────────────────────────────────────────────

def process_chats_with(bot, items: list[dict], judgments: dict) -> list[str]:
    """Reply to pre-judged chat items. Reuses LLM results from pre-check phase.

    items: from _scan_chats_items (already LLM-judged worthy).
    judgments: LLM judgments dict keyed by item id.
    """
    uid = bot["user_id"]
    token = bot["token"]
    lang = bot["language"]
    personality = bot["personality"]
    system_prompt = bot.get("system_prompt", "")

    # Filter to worth-reply items
    reply_candidates = [
        (item, judgments.get(str(item["id"]), {}))
        for item in items
        if judgments.get(str(item["id"]), {}).get("worthy_reply", False)
    ]

    if not reply_candidates:
        return []

    # Randomly pick up to 2
    selected = random.sample(reply_candidates, min(2, len(reply_candidates)))

    results = []
    for item, judgment in selected:
        chat_id = int(item["id"])
        content = item["content"]

        ctx = ReplyContext(
            source_content=content,
            context_type="chat",
            personality=personality,
            language=lang,
            system_prompt=system_prompt,
        )
        reply = generate_reply(ctx, max_len=1024)
        if not reply:
            continue

        ok = api("POST", f"/chats/{chat_id}/messages", token, uid,
                 data={"user_id": uid, "content": reply})
        if ok:
            results.append(f"chat→{chat_id}: {reply[:50]}")
            _replied[_reply_key(uid, "chat", chat_id)] = time.time()

    return results


# ── Step 2: Message notifications ────────────────────────────────────────────

def process_messages_with(bot, items: list[dict], judgments: dict) -> list[str]:
    """Reply to pre-judged message items. Reuses LLM results from pre-check phase.

    items: from _scan_messages_items.
    judgments: LLM judgments dict keyed by item id.
    """
    uid = bot["user_id"]
    token = bot["token"]
    lang = bot["language"]
    personality = bot["personality"]
    system_prompt = bot.get("system_prompt", "")

    results = []
    for item, judgment in selected:
        msg_id = int(item["id"])
        content = item["content"]
        post_id = item["_post_id"]
        comment_id = item["_comment_id"]
        post_content = item["post_content"]

        ctx = ReplyContext(
            source_content=content,
            post_content=post_content or "",
            context_type="notification",
            personality=personality,
            language=lang,
            system_prompt=system_prompt,
        )
        reply = generate_reply(ctx, max_len=1024)
        if not reply:
            continue

        if post_id and comment_id:
            ok = api("POST", f"/posts/{post_id}/comments", token, uid,
                     data={"user_id": uid, "content": reply, "reply_to_comment_id": comment_id})
        elif post_id:
            ok = api("POST", f"/posts/{post_id}/comments", token, uid,
                     data={"user_id": uid, "content": reply, "reply_to_comment_id": None})
        else:
            ok = None

        if ok:
            results.append(f"msg→{msg_id}: {reply[:50]}")
            _replied[_reply_key(uid, "msg", msg_id)] = time.time()

    return results


# ── Step 3: Feed + Comments ──────────────────────────────────────────────────

def process_feed(bot, max_posts=50, max_comments=5):
    """Feed scan with LLM-based batch judgment.

    Flow:
      1. GET /posts -> quick pre-filter (skip own posts, skip already-replied)
      2. Batch LLM call for all posts -> decide worth_reply / worth_like
      3. Execute per post: like if worthy, fetch full post for reply-worthy ones
      4. Scan comments from full post, batch-judge them via LLM
      5. Execute replies and likes based on LLM judgment
    """
    uid = bot["user_id"]
    token = bot["token"]
    lang = bot["language"]
    personality = bot["personality"]
    system_prompt = bot.get("system_prompt", "")

    posts_data = api("GET", "/posts", token, uid)
    if not posts_data:
        return []

    posts = posts_data if isinstance(posts_data, list) else posts_data.get("posts", posts_data.get("results", []))
    if not posts:
        return []

    # -- Phase 1: quick pre-filter, collect post items for batch judgment --
    post_items = []
    for post in posts[:max_posts]:
        post_id = post.get("id")
        if not post_id:
            continue
        if _replied.get(_reply_key(uid, "post", post_id)):
            continue
        author = post.get("author", {})
        post_author_id = author.get("account_id") or author.get("user_id")
        if post_author_id == uid:
            continue
        content = _clean_text(post.get("content", ""))
        if not content or len(content.strip()) < 5:
            continue
        post_items.append({
            "id": str(post_id),
            "type": "post",
            "content": content,
            "post_content": None,
        })

    # -- Phase 2: batch LLM judgment for posts --
    post_judgments = _llm_judge_batch(post_items, lang) if post_items else {}

    results = []

    # -- Phase 3: execute per post --
    for item in post_items:
        post_id = int(item["id"])
        content = item["content"]
        j = post_judgments.get(str(post_id), {})
        worthy_like = j.get("worthy_like", False)
        worthy_reply = j.get("worthy_reply", False)

        # Like if worthy
        if worthy_like:
            ok = api("POST", f"/posts/{post_id}/favorite", token, uid, data={"user_id": uid})
            if ok:
                results.append(f"  ♡ post {post_id}")

        # Only fetch full post if reply-worthy OR liked (to scan comments)
        if not (worthy_reply or worthy_like):
            continue

        post_data = api("GET", f"/posts/{post_id}", token, uid)
        if not post_data:
            continue
        comments = post_data.get("comments", []) if isinstance(post_data, dict) else []
        if not isinstance(comments, list):
            comments = []

        # -- Reply to post if worthy --
        if worthy_reply:
            recent_comments = [
                _clean_text(c.get("content", ""))
                for c in comments[-max_comments:]
                if c.get("id")
                and (c.get("author", {}).get("account_id") or c.get("author", {}).get("user_id")) != uid
                and _clean_text(c.get("content", ""))
            ]
            ctx = ReplyContext(
                source_content=content,
                recent_comments=recent_comments[:4],
                context_type="post",
                personality=personality,
                language=lang,
                system_prompt=system_prompt,
            )
            reply = generate_reply(ctx, max_len=1024)
            if reply:
                ok = api("POST", f"/posts/{post_id}/comments", token, uid,
                         data={"user_id": uid, "content": reply, "reply_to_comment_id": None})
                if ok:
                    results.append(f"post {post_id}: {reply[:60]}")
                    _replied[_reply_key(uid, "post", post_id)] = time.time()

        # -- Scan and judge comments --
        comment_items = []
        for comment in comments[:max_comments]:
            cid = comment.get("id")
            if not cid:
                continue
            if _replied.get(_reply_key(uid, "comment", cid)):
                continue
            comment_author_id = comment.get("author", {}).get("account_id") or comment.get("author", {}).get("user_id")
            if comment_author_id == uid:
                continue
            comment_content = _clean_text(comment.get("content", ""))
            if not comment_content:
                continue
            comment_items.append({
                "id": str(cid),
                "type": "comment",
                "content": comment_content,
                "post_content": content,
            })

        comment_judgments = _llm_judge_batch(comment_items, lang) if comment_items else {}

        for citem in comment_items:
            cid = int(citem["id"])
            comment_content = citem["content"]
            cj = comment_judgments.get(str(cid), {})
            worthy_like_c = cj.get("worthy_like", False)
            worthy_reply_c = cj.get("worthy_reply", False)

            if worthy_like_c:
                api("POST", f"/posts/{post_id}/comments/{cid}/like", token, uid, data={"user_id": uid})

            if worthy_reply_c:
                other_comments = [
                    _clean_text(oc.get("content", ""))
                    for oc in comments[-max_comments:]
                    if oc.get("id") and oc.get("id") != cid
                    and (oc.get("author", {}).get("account_id") or oc.get("author", {}).get("user_id")) != uid
                    and _clean_text(oc.get("content", ""))
                ]
                ctx = ReplyContext(
                    source_content=comment_content,
                    post_content=content,
                    recent_comments=other_comments[:4],
                    context_type="comment",
                    personality=personality,
                    language=lang,
                    system_prompt=system_prompt,
                )
                reply = generate_reply(ctx, max_len=1024)
                if reply:
                    ok = api("POST", f"/posts/{post_id}/comments", token, uid,
                             data={"user_id": uid, "content": reply, "reply_to_comment_id": cid})
                    if ok:
                        results.append(f"  comment {cid}: {reply[:50]}")
                        _replied[_reply_key(uid, "comment", cid)] = time.time()

        time.sleep(1)

    return results


def process_feed_items(bot, feed_items: list[dict], max_comments: int = 5) -> list[str]:
    """Reply to pre-selected feed items (posts + their comments).

    feed_items: list of items from _scan_feed_items (already LLM-judged worthy).
    Each item has: id(str), type="post", content, post_content, _raw(post dict).

    Flow per item:
      1. Fetch full post for comment scan
      2. Batch-judge comments, pick up to 2 worth-replying
      3. Reply to post (with comment context)
      4. Reply to selected comments
    """
    uid = bot["user_id"]
    token = bot["token"]
    lang = bot["language"]
    personality = bot["personality"]
    system_prompt = bot.get("system_prompt", "")

    results = []
    for item in feed_items:
        post_id = int(item["id"])
        content = item["content"]

        # Fetch full post for comments
        post_data = api("GET", f"/posts/{post_id}", token, uid)
        if not post_data:
            continue
        comments = post_data.get("comments", []) if isinstance(post_data, dict) else []
        if not isinstance(comments, list):
            comments = []

        # ── Collect comment items for batch judgment ──────────────────────────
        comment_items = []
        for comment in comments[:max_comments]:
            cid = comment.get("id")
            if not cid:
                continue
            if _replied.get(_reply_key(uid, "comment", cid)):
                continue
            comment_author_id = comment.get("author", {}).get("account_id") or comment.get("author", {}).get("user_id")
            if comment_author_id == uid:
                continue
            comment_content = _clean_text(comment.get("content", ""))
            if not comment_content:
                continue
            comment_items.append({
                "id": str(cid),
                "type": "comment",
                "content": comment_content,
                "post_content": content,
            })

        comment_judgments = _llm_judge_batch(comment_items, lang) if comment_items else {}

        # Filter to worthy-reply comments, randomly pick up to 2
        reply_candidates = [
            (ci, comment_judgments.get(str(ci["id"]), {}))
            for ci in comment_items
            if comment_judgments.get(str(ci["id"]), {}).get("worthy_reply", False)
        ]
        if len(reply_candidates) > 2:
            reply_candidates = random.sample(reply_candidates, 2)

        # ── Reply to post ────────────────────────────────────────────────────
        recent_comments = [
            _clean_text(c.get("content", ""))
            for c in comments[-max_comments:]
            if c.get("id")
            and (c.get("author", {}).get("account_id") or c.get("author", {}).get("user_id")) != uid
            and _clean_text(c.get("content", ""))
        ]
        ctx = ReplyContext(
            source_content=content,
            recent_comments=recent_comments[:4],
            context_type="post",
            personality=personality,
            language=lang,
            system_prompt=system_prompt,
        )
        reply = generate_reply(ctx, max_len=1024)
        if reply:
            ok = api("POST", f"/posts/{post_id}/comments", token, uid,
                     data={"user_id": uid, "content": reply, "reply_to_comment_id": None})
            if ok:
                results.append(f"post {post_id}: {reply[:60]}")
                _replied[_reply_key(uid, "post", post_id)] = time.time()

        # ── Reply to selected comments ───────────────────────────────────────
        for ci, cj in reply_candidates:
            cid = int(ci["id"])
            comment_content = ci["content"]
            other_comments = [
                _clean_text(oc.get("content", ""))
                for oc in comments[-max_comments:]
                if oc.get("id") and oc.get("id") != cid
                and (oc.get("author", {}).get("account_id") or oc.get("author", {}).get("user_id")) != uid
                and _clean_text(oc.get("content", ""))
            ]
            ctx = ReplyContext(
                source_content=comment_content,
                post_content=content,
                recent_comments=other_comments[:4],
                context_type="comment",
                personality=personality,
                language=lang,
                system_prompt=system_prompt,
            )
            reply = generate_reply(ctx, max_len=1024)
            if reply:
                ok = api("POST", f"/posts/{post_id}/comments", token, uid,
                         data={"user_id": uid, "content": reply, "reply_to_comment_id": cid})
                if ok:
                    results.append(f"  comment {cid}: {reply[:50]}")
                    _replied[_reply_key(uid, "comment", cid)] = time.time()

        time.sleep(1)

    return results


# ── Quick source pre-check ───────────────────────────────────────────────────

def _scan_chats_items(bot) -> tuple[int, list[dict], dict]:
    """Fetch chats, batch-judge with LLM, return (count_worthy, items, judgments).

    Returns items and judgments so execute phase can reuse without re-calling LLM.
    """
    uid = bot["user_id"]
    token = bot["token"]
    lang = bot["language"]

    data = api("GET", f"/users/{uid}/chats", token, uid)
    if not data:
        return 0, [], {}

    chats = data if isinstance(data, list) else data.get("chats", data.get("results", []))
    if not chats:
        return 0, [], {}

    items = []
    for chat in chats[:10]:
        chat_id = chat.get("id")
        if not chat_id:
            continue
        if _replied.get(_reply_key(uid, "chat", chat_id)):
            continue

        thread = api("GET", f"/chats/{chat_id}", token, uid)
        if not thread:
            continue

        messages = thread if isinstance(thread, list) else thread.get("messages", thread.get("results", []))
        if not messages:
            continue

        last = messages[-1]
        last_sender = last.get("author", {}).get("account_id") or last.get("account_id")
        last_content = _clean_text(last.get("content", ""))

        if last_sender == uid:
            continue
        if not last_content or len(last_content.strip()) < 2:
            continue

        items.append({
            "id": str(chat_id),
            "type": "chat",
            "content": last_content,
            "post_content": None,
            "_messages": messages,
        })

    if not items:
        return 0, [], {}

    judgments = _llm_judge_batch(items, lang)
    worthy = [item for item in items if judgments.get(str(item["id"]), {}).get("worthy_reply", False)]
    return len(worthy), items, judgments


def _scan_messages_items(bot) -> tuple[int, list[dict], dict]:
    """Fetch messages, batch-judge with LLM, return (count_worthy, items, judgments).

    Returns items and judgments so execute phase can reuse without re-calling LLM.
    """
    uid = bot["user_id"]
    token = bot["token"]
    lang = bot["language"]

    data = api("GET", f"/users/{uid}/messages", token, uid)
    if not data:
        return 0, [], {}

    messages = data if isinstance(data, list) else data.get("messages", data.get("results", []))
    if not messages:
        return 0, [], {}

    items = []
    for msg in messages[:20]:
        msg_id = msg.get("id")
        if not msg_id:
            continue
        if _replied.get(_reply_key(uid, "msg", msg_id)):
            continue

        content = _clean_text(msg.get("comment_content", "") or msg.get("content", ""))
        if not content or len(content.strip()) < 2:
            continue

        items.append({
            "id": str(msg_id),
            "type": "message",
            "content": content,
            "post_content": None,
            "_post_id": msg.get("post_id"),
            "_comment_id": msg.get("comment_id"),
        })

    if not items:
        return 0, [], {}

    judgments = _llm_judge_batch(items, lang)
    worthy = [item for item in items if judgments.get(str(item["id"]), {}).get("worthy_reply", False)]
    return len(worthy), items, judgments


def _scan_feed_items(bot, max_posts: int = 20) -> tuple[int, list[dict]]:
    """Batch-judge feed posts, return (count_worthy, list_of_worthy_items).

    Each returned item: {"id": str, "type": "post", "content": str, "post_content": None}
    Does NOT fetch individual post details (no comments included).
    """
    uid = bot["user_id"]
    token = bot["token"]
    lang = bot["language"]

    posts_data = api("GET", "/posts", token, uid)
    if not posts_data:
        return 0, []

    posts = posts_data if isinstance(posts_data, list) else posts_data.get("posts", posts_data.get("results", []))
    if not posts:
        return 0, []

    items = []
    for post in posts[:max_posts]:
        post_id = post.get("id")
        if not post_id:
            continue
        if _replied.get(_reply_key(uid, "post", post_id)):
            continue
        author = post.get("author", {})
        post_author_id = author.get("account_id") or author.get("user_id")
        if post_author_id == uid:
            continue
        content = _clean_text(post.get("content", ""))
        if not content or len(content.strip()) < 2:
            continue
        items.append({
            "id": str(post_id),
            "type": "post",
            "content": content,
            "post_content": None,
            "_raw": post,
        })

    if not items:
        return 0, []

    judgments = _llm_judge_batch(items, lang)
    worthy = [
        item for item in items
        if judgments.get(str(item["id"]), {}).get("worthy_reply", False)
    ]
    return len(worthy), worthy


# ── Main ─────────────────────────────────────────────────────────────────────

def main():
    _load_cache()

    print(f"[{datetime.now(timezone.utc).isoformat()}] GameltBook Comment Bot starting...")
    print(f"  LLM available: {'MiniMax' if _MINIMAX_API_KEY else 'No (using template fallback)'}")

    config = load_config()
    bots = select_bots(config)
    max_comments = config.get("feed", {}).get("max_comments", 5)

    print(f"Selected {len(bots)} bots: {[b['user_id'] for b in bots]}")

    for bot in bots:
        uid = bot["user_id"]
        personality = bot["personality"]
        print(f"\n--- Bot {uid} ({personality}) ---")

        # ── Phase 1: pre-check each source (scan + batch LLM judgment) ─────────
        print("  [pre-check] probing sources...")
        chat_count, chat_items, chat_judgments = _scan_chats_items(bot)
        msg_count,  msg_items,  msg_judgments  = _scan_messages_items(bot)
        feed_count, feed_worthy_items            = _scan_feed_items(bot, max_posts=20)

        print(f"  [pre-check] chat={chat_count} messages={msg_count} feed={feed_count}")

        # Build weighted pool from sources that have content
        pool = []   # [(source_name, weight), ...]
        if chat_count > 0:
            pool.append(("chat",     3))
        if msg_count > 0:
            pool.append(("messages", 2))
        if feed_count > 0:
            pool.append(("feeds",    1))

        if not pool:
            print("  所有来源都没有值得回复的内容，跳过")
            time.sleep(2)
            continue

        # Weighted random pick
        total = sum(w for _, w in pool)
        roll  = random.random() * total
        cumulative = 0
        source = pool[-1][0]  # default to last
        for name, weight in pool:
            cumulative += weight
            if roll < cumulative:
                source = name
                break

        print(f"  选中来源: {source} (权重池: {pool})")

        # ── Phase 2: execute selected source (reuses LLM judgments from pre-check) ──
        if source == "chat":
            results = process_chats_with(bot, chat_items, chat_judgments)
        elif source == "messages":
            results = process_messages_with(bot, msg_items, msg_judgments)
        else:
            results = process_feed_items(bot, feed_worthy_items, max_comments=max_comments)

        for r in results:
            print(f"  ✓ {r}")
        if not results:
            print("  (无实际操作)")

        time.sleep(2)

    _save_cache()
    print(f"\n[{datetime.now(timezone.utc).isoformat()}] Done.")


if __name__ == "__main__":
    main()
